\newcommand {\ungraded }[0]{\ifvmode \IgnorePar \fi \EndP \HCode {<div class="ungraded">}\IgnoreIndent }
\newcommand {\footnote }[1]{\ifvmode \ShowPar \fi \stepcounter {footnoteNum}\HCode { <script type="text/javascript"> function footnotefun(ID) { var x = document.getElementById(ID); if (x.style.display === "none") { x.style.color = "blue"; x.style.display = "inline"; } else { x.style.display = "none"; } }} \HCode {</script>} \expandafter \HCode { <span style="position=relative; vertical-align=baseline;"> <button onclick='footnotefun("footnote\roman {footnoteNum}")' style= "background:none!important; color:inherit; border:none; padding:0!important; font: inherit; cursor: pointer;" > <sup>}[\arabic {footnoteNum}] \HCode {</sup></button>} \expandafter \HCode { <span id="footnote\roman {footnoteNum}" style= "display:none; min-width:20em; position:relative; left:2px; padding:5px; color:blue; word-wrap:break-word; z-index=9999; overflow=auto;" > } \textcolor {fncolor}{(##1)}\HCode {</span></span>} }
\newcommand {\accordion }[0]{\ifvmode \IgnorePar \fi \EndP \HCode {<div class="accordion">} }
\newcommand {\hint }[0]{\expandafter \Collect@Body \csname env@hint@parse\endcsname }
\newcommand {\env@hint@save@env }[0]{\expandafter \expandafter \expandafter \env@save \csname env@hint@BODY\endcsname }
\newcommand {\env@hint@process }[0]{\begin {expandable}{xmhint}{}\BODY \end {expandable}\env@ignore }
\newcommand {\expandable }[2]{\stepcounter {identification}\ifvmode \IgnorePar \fi \EndP \HCode {<div class="accordion">\Hnewline }\HCode {<h3 class="##1">}##2\HCode {</h3>\Hnewline }\HCode {<div id="accordion-item\arabic {identification}" class="accordion-item ##1-content">\Hnewline } }
